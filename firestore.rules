rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny — every collection below must explicitly opt in.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Unified user schema (merges caption's quota fields + EventCam's
    // status/usage fields — see src/types/user.ts and
    // riddimroom-studio-phase0-plan.md section 4.2).
    //
    // All writes to this collection happen server-side via the Firebase
    // Admin SDK (server.ts /api/user/status), which bypasses these rules
    // entirely. Clients only ever read their own document — role, status,
    // and quota are never client-writable, per the Phase 1 security
    // requirement that all privileged data changes go through an
    // authenticated backend route. This is a deliberate tightening versus
    // riddimroom-caption, which allowed the client to directly update a
    // handful of fields (email/displayName/photoURL/dailyCount/etc) on its
    // own user document.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Admin trust-root — console/backend managed only (ported from
    // EventCam's /admins/{uid} model). Not used by anything in Phase 1 yet.
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read, write: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
    }
  }
}
