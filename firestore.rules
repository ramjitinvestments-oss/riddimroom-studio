rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny — every collection below must explicitly opt in.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Unified user schema (merges caption's quota fields + EventCam's
    // status/usage fields — see src/types/user.ts and
    // riddimroom-studio-phase0-plan.md section 4.2).
    //
    // All writes to this collection happen server-side via the Firebase
    // Admin SDK (server.ts /api/user/status), which bypasses these rules
    // entirely. Clients only ever read their own document — role, status,
    // and quota are never client-writable, per the Phase 1 security
    // requirement that all privileged data changes go through an
    // authenticated backend route. This is a deliberate tightening versus
    // riddimroom-caption, which allowed the client to directly update a
    // handful of fields (email/displayName/photoURL/dailyCount/etc) on its
    // own user document.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Admin trust-root — console/backend managed only (ported from
    // EventCam's /admins/{uid} model). v1 hardening: owner-only read
    // (was: any signed-in user could read any admin doc).
    match /admins/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // v1 licensing — written ONLY by the Stripe webhook handler in
    // server.ts (Admin SDK bypasses rules). Clients read only their own.
    match /licenses/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // v1 global config (kill-switch) — read by any signed-in user so the
    // client can show "temporarily unavailable"; writes are console/backend only.
    // The server enforces disabled=true in /api/user/status (rules alone
    // cannot enforce a kill-switch, since the server bypasses rules).
    match /config/global {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      // v1: field validation on create/update — ownerUid immutable, name is a string.
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name is string;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
