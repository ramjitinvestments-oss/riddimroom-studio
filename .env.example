# GEMINI_API_KEY: required for AI transcription (added in the AI transcription build step)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WHISPER_API_URL: optional fallback transcription endpoint, used only if
# GEMINI_API_KEY is unset. No default deployment exists yet (see PROGRESS.md
# Risks) — point this at a Whisper-compatible HTTP endpoint that accepts
# {mediaUrl, mimeType} and returns {words: [{text, start, end}]}. Leave unset
# to disable the fallback (POST /api/transcribe returns a clear 503 if
# neither GEMINI_API_KEY nor WHISPER_API_URL is configured).
WHISPER_API_URL=""

# APP_URL: the URL this app is hosted at (Cloud Run service URL in production)
APP_URL="MY_APP_URL"
