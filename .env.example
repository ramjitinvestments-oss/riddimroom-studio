# RiddimRoom Studio — environment variables (v1)
# Copy to .env for local dev. NEVER commit a real .env with keys.
# All values below are PLACEHOLDERS — empty means "not configured".
# The server returns a clear 503/400 when a feature's keys are missing,
# instead of silently failing.

# --- AI transcription (server-only) ---
# GEMINI_API_KEY: required for AI transcription (primary provider)
GEMINI_API_KEY=
# WHISPER_API_URL: optional fallback transcription endpoint, used only if
# GEMINI_API_KEY is unset. Point at a Whisper-compatible HTTP endpoint that
# accepts {mediaUrl, mimeType} and returns {words: [{text, start, end}]}.
WHISPER_API_URL=

# --- App ---
# APP_URL: the URL this app is hosted at (Cloud Run service URL in production).
# Used for the CORS allowlist. Localhost origins are always allowed.
APP_URL=
# PORT: server listen port (default 3000)
PORT=3000
NODE_ENV=development

# --- Firebase (server) ---
# FIREBASE_PROJECT_ID: single project for v1 = riddimroom-studio
FIREBASE_PROJECT_ID=riddimroom-studio
# FIREBASE_SERVICE_ACCOUNT_JSON: service-account JSON as a single-line string
# (for local dev / non-Cloud-Run hosts). On Cloud Run, use Application
# Default Credentials instead — leave this empty.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Firebase (client, VITE_ prefix — exposed to the browser) ---
# These are NOT secrets (Firebase web config is public by design), but keep
# them in .env rather than hardcoding so staging/prod can differ.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=riddimroom-studio
VITE_FIREBASE_STORAGE_BUCKET=riddimroom-studio.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Stripe (v1 licensing — one-time lifetime unlock) ---
# TODO: set these in your deployment env to enable real checkout.
# No real keys are in this repo. Until set, /api/checkout returns 503
# and the app shows "setup needed" — no payment is taken.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_LIFETIME=
